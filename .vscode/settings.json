{
  "files.exclude": {
    "**/.DS_Store": true,
    ".hugo_build.lock": true,
    ".devcontainer": true,
    "LICENSE": true,

    // === go ===
    "go.mod": true,
    "go.sum": true,

    // === hugo ===
    // "config/": true,
    // "config/_default/": true,
    "resources/": true,
    "public/": true,
    "assets/scss": true,
    "assets/jsconfig.json": true,

    // === hugo-theme-stack ===
    ".github": true,
    // ".github/workflows/update-theme.yml": true,
    // ".github/workflows/deploy.yml": true

    // === front matter cms | vscode extension ===
    // ".frontmatter/": true,
    // "frontmatter.json": true

    // === js ===
    "node_modules": true,

    // === python ===
    ".venv": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 80
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.wordWrap": "off",
    "files.eol": "\n"
  },
  "foam.links.sync.enable": false,
  "foam.completion.linkFormat": "link"
}
